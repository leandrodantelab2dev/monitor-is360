<mvc:View
	controllerName="com.allos.is360.controller.Iflows"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'com/allos/is360/model/formatter'
	}">

	<Page id="iflowsPage" title="{i18n>iflowsTitle}" showNavButton="true" navButtonPress=".onNavBack">
		<subHeader>
			<Toolbar>
				<SearchField id="searchField" width="20rem" liveChange=".onSearch" placeholder="{i18n>searchPlaceholder}"/>
				<ToolbarSpacer/>
				<Button id="sortButton" icon="sap-icon://sort" text="{i18n>btnSort}" press=".onToggleSort" type="Transparent"/>
				<Button icon="sap-icon://refresh" tooltip="{i18n>btnRefresh}" press=".onRefresh" type="Transparent"/>
			</Toolbar>
		</subHeader>
		<content>
			<Toolbar class="sapUiTinyMarginBottom sapUiTinyMarginBeginEnd">
				<Label text="{i18n>filterPackageLabel}" labelFor="packageFilter" class="sapUiTinyMarginEnd"/>
				<Select id="packageFilter" width="12rem" items="{filters>/packages}" selectedKey="{filters>/selectedPackage}"
					change=".onPackageFilterChange" class="sapUiSmallMarginEnd">
					<core:Item key="{filters>key}" text="{filters>text}"/>
				</Select>
				<Label text="{i18n>filterScoreLabel}" class="sapUiTinyMarginEnd"/>
				<RangeSlider id="scoreRangeFilter" width="10rem" min="0" max="100" step="1"
					range="{filters>/scoreRange}" change=".onScoreRangeChange" class="sapUiSmallMarginEnd"/>
				<ToolbarSpacer/>
				<Button text="{i18n>btnClearFilters}" press=".onClearFilters" type="Transparent"/>
			</Toolbar>

			<HBox wrap="Wrap" class="sapUiTinyMarginBottom sapUiTinyMarginBeginEnd">
				<HBox alignItems="Center" class="is360-chip sapUiTinyMarginEnd" visible="{= !!${filters>/packageChipText} }">
					<Text text="{filters>/packageChipText}"/>
					<Button icon="sap-icon://decline" type="Transparent" press=".onClearPackageFilter" class="is360-chip-remove"/>
				</HBox>
				<HBox alignItems="Center" class="is360-chip sapUiTinyMarginEnd" visible="{= !!${filters>/scoreChipText} }">
					<Text text="{filters>/scoreChipText}"/>
					<Button icon="sap-icon://decline" type="Transparent" press=".onClearScoreFilter" class="is360-chip-remove"/>
				</HBox>
				<HBox alignItems="Center" class="is360-chip sapUiTinyMarginEnd" visible="{= !!${filters>/ruleChipText} }">
					<Text text="{filters>/ruleChipText}"/>
					<Button icon="sap-icon://decline" type="Transparent" press=".onClearRuleFilter" class="is360-chip-remove"/>
				</HBox>
			</HBox>

			<IconTabBar id="iconTabBar" select=".onTabSelect" selectedKey="all" expandable="false">
				<items>
					<IconTabFilter key="all" text="{i18n>tabAll}" count="{counts>/all}"/>
					<IconTabFilter key="verde" text="{i18n>statVerde}" count="{counts>/verde}" icon="sap-icon://status-positive" iconColor="Positive"/>
					<IconTabFilter key="amarelo" text="{i18n>statAmarelo}" count="{counts>/amarelo}" icon="sap-icon://status-critical" iconColor="Critical"/>
					<IconTabFilter key="vermelho" text="{i18n>statVermelho}" count="{counts>/vermelho}" icon="sap-icon://status-negative" iconColor="Negative"/>
				</items>
				<content>
					<Table id="iflowsTable" items="{/Iflows}" growing="true" growingScrollToLoad="true" noDataText="{i18n>noIflowsText}">
						<columns>
							<Column><Text text="{i18n>colName}"/></Column>
							<Column><Text text="{i18n>colPackage}"/></Column>
							<Column hAlign="End" width="8rem"><Text text="{i18n>colScore}"/></Column>
							<Column><Text text="{i18n>colBand}"/></Column>
						</columns>
						<items>
							<ColumnListItem type="Navigation" press=".onOpenIflow">
								<cells>
									<Text text="{name}"/>
									<Text text="{package/name}"/>
									<VBox alignItems="End">
										<ObjectNumber
											number="{score}"
											state="{path: 'band', formatter: 'formatter.bandState'}"/>
										<ProgressIndicator
											percentValue="{score}"
											state="{path: 'band', formatter: 'formatter.bandState'}"
											showValue="false"
											width="4rem"
											height="0.375rem"/>
									</VBox>
									<ObjectStatus
										text="{path: 'band', formatter: 'formatter.bandText'}"
										state="{path: 'band', formatter: 'formatter.bandState'}"
										icon="{path: 'band', formatter: 'formatter.bandIcon'}"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</content>
			</IconTabBar>
		</content>
	</Page>
</mvc:View>
