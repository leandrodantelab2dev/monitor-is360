<mvc:View
	controllerName="com.allos.is360.controller.IflowDetail"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:micro="sap.suite.ui.microchart"
	core:require="{
		formatter: 'com/allos/is360/model/formatter'
	}">

	<Page id="iflowDetailPage" showNavButton="true" navButtonPress=".onNavBack">
		<customHeader>
			<Bar>
				<contentLeft>
					<Button icon="sap-icon://nav-back" press=".onNavBack" type="Transparent"/>
					<Title text="{name}" level="H2" class="sapUiTinyMarginBegin"/>
				</contentLeft>
				<contentRight>
					<Button text="{i18n>btnAnalyze}" icon="sap-icon://validate" press=".onAnalyze" type="Emphasized"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<Panel class="sapUiResponsiveMargin">
				<HBox alignItems="Center" wrap="Wrap">
					<HBox alignItems="Center" class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
						<micro:RadialMicroChart
							percentage="{score}"
							valueColor="{path: 'band', formatter: 'formatter.bandValueColor'}"
							size="M"
							class="sapUiSmallMarginEnd"/>
						<VBox>
							<ObjectStatus
								text="{path: 'band', formatter: 'formatter.bandText'}"
								state="{path: 'band', formatter: 'formatter.bandState'}"
								class="sapUiTinyMarginBottom"/>
							<ObjectAttribute text="{description}"/>
							<ObjectAttribute text="{package/name}"/>
							<ObjectAttribute text="{version}"/>
						</VBox>
					</HBox>
					<HBox>
						<VBox alignItems="Center" class="sapUiSmallMarginStart">
							<ObjectNumber number="{summary>/total}"/>
							<Text text="{i18n>colRulesTotal}"/>
						</VBox>
						<VBox alignItems="Center" class="sapUiSmallMarginStart">
							<ObjectNumber number="{summary>/passed}" state="Success"/>
							<Text text="{i18n>colPassed}"/>
						</VBox>
						<VBox alignItems="Center" class="sapUiSmallMarginStart">
							<ObjectNumber number="{summary>/failed}" state="Error"/>
							<Text text="{i18n>colFailed}"/>
						</VBox>
					</HBox>
				</HBox>
			</Panel>

			<VBox class="sapUiResponsiveMargin">
				<Toolbar>
					<Title text="{i18n>fixFirstTitle}" level="H3"/>
					<ToolbarSpacer/>
					<Label text="{i18n>toggleShowOnlyFailed}" labelFor="onlyFailedSwitch" class="sapUiTinyMarginEnd"/>
					<Switch id="onlyFailedSwitch" state="{rules>/showOnlyFailed}" change=".onToggleShowOnlyFailed"/>
				</Toolbar>

				<Table id="failedTable" noDataText="{i18n>noFailedText}" items="{rules>/failed}">
					<columns>
						<Column width="3rem"/>
						<Column width="6rem"><Text text="{i18n>colRule}"/></Column>
						<Column width="6.5rem"><Text text="{i18n>colSeverity}"/></Column>
						<Column><Text text="{i18n>colDetail}"/></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<core:Icon src="sap-icon://sys-cancel-2" color="Negative"/>
								<Text text="{rules>ruleId}"/>
								<ObjectStatus text="{path: 'rules>severidade', formatter: 'formatter.severityText'}" class="is360-severity-badge"/>
								<Text text="{rules>detalhe}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>

				<Panel expandable="true" expanded="false" visible="{= !${rules>/showOnlyFailed} }"
					headerText="{rules>/passedCollapsedLabel}" class="sapUiTinyMarginTop">
					<Table id="passedTable" noDataText="{i18n>noResultsText}" items="{rules>/passed}">
						<columns>
							<Column width="3rem"/>
							<Column><Text text="{i18n>colRule}"/></Column>
							<Column><Text text="{i18n>colSeverity}"/></Column>
							<Column><Text text="{i18n>colDetail}"/></Column>
						</columns>
						<items>
							<ColumnListItem>
								<cells>
									<core:Icon src="sap-icon://sys-enter-2" color="Positive"/>
									<Text text="{rules>ruleId}"/>
									<ObjectStatus text="{path: 'rules>severidade', formatter: 'formatter.severityText'}" class="is360-severity-badge"/>
									<Text text="{rules>detalhe}"/>
								</cells>
							</ColumnListItem>
						</items>
					</Table>
				</Panel>
			</VBox>
		</content>
	</Page>
</mvc:View>
