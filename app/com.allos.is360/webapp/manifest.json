{
	"_version": "2.0.0",

	"sap.app": {
		"id": "com.allos.is360",
		"type": "application",
		"i18n": "i18n/i18n.properties",
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "${version}"
		},
		"dataSources": {
			"default": {
				"uri": "/odata/v4/monitor/",
				"type": "OData",
				"settings": {
					"odataVersion": "4.0"
				}
			}
		},
		"sourceTemplate": {
			"id": "@ui5/mcp-server:js",
			"version": "0.2.18"
		}
	},

	"sap.ui": {
		"technology": "UI5",
		"icons": {},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},

	"sap.ui5": {
		"rootView": {
			"viewName": "com.allos.is360.view.App",
			"type": "XML",
			"id": "app"
		},

		"dependencies": {
			"minUI5Version": "1.151.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.suite.ui.microchart": {}
			}
		},

		"handleValidation": true,

		"contentDensities": {
			"compact": true,
			"cozy": true
		},

		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.allos.is360.i18n.i18n",
					"async": true
				}
			},
			"": {
				"dataSource": "default",
				"preload": true,
				"settings": {
					"autoExpandSelect": true,
					"earlyRequests": true,
					"operationMode": "Server"
				}
			}
		},

		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "com.allos.is360.view",
				"controlId": "app",
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"pattern": "",
					"name": "overview",
					"target": "overview"
				},
				{
					"pattern": "iflows",
					"name": "iflows",
					"target": "iflows"
				},
				{
					"pattern": "iflows/{iflowId}",
					"name": "iflowDetail",
					"target": "iflowDetail"
				}
			],
			"targets": {
				"overview": {
					"id": "overview",
					"name": "Overview"
				},
				"iflows": {
					"id": "iflows",
					"name": "Iflows"
				},
				"iflowDetail": {
					"id": "iflowDetail",
					"name": "IflowDetail"
				}
			}
		}
	}
}
